{
  "sourceLanguage": "tr",
  "strings": {
    "\"%@\" analiz ediliyor…": {
      "comment": "A label indicating that a word is being analyzed. The argument is the word that is being analyzed.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzing \"%@\"…"
          }
        }
      }
    },
    "\"%@\" kelimesi AI ile analiz edilip kütüphanene eklenecek.": {
      "comment": "A message shown in a confirmation dialog when the user confirms adding a new word to their library. The argument is the term of the word to be added.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" will be analyzed by AI and added to your library."
          }
        }
      }
    },
    "\"%@\" listene eklendi": {
      "comment": "A label inside the toast that announces that a word has been successfully added to the user's vocabulary list. The argument is the word that was added.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" added to your list"
          }
        }
      }
    },
    "\"%@\" silinecek. İçindeki %lld kelime silinmeyecek, sadece deste bağı kalkacak.": {
      "comment": "An alert message explaining that a selected deck will be deleted, but its words will not be lost. The placeholder text inside the quotation marks should be replaced with the name of the deck.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" will be deleted. The %2$lld words inside stay; only deck membership is removed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "\"%1$@\" silinecek. İçindeki %2$lld kelime silinmeyecek, sadece deste bağı kalkacak."
          }
        }
      }
    },
    "%@ destesi — %lld kelime": {
      "comment": "A title that combines the English level label with the word \"destesi\" and the count of words in the library for that level. The first argument is the English level label. The second argument is the count of words.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deck — %2$lld words"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ destesi — %2$lld kelime"
          }
        }
      }
    },
    "%@. İlişkiler doğrulanamadı.": {
      "comment": "A badge that appears when the AI-generated synonyms, antonyms, and related words for a word cannot be verified by Datamuse. The message inside the badge is provided as a parameter.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Relations could not be verified."
          }
        }
      }
    },
    "%lld": {
      "comment": "A small text label displayed next to a bar in a chart, showing the value of that bar.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
